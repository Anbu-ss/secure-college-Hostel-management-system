{
    "experimentalServices": {
        "frontend": {
            "entrypoint": "frontend",
            "routePrefix": "/",
            "framework": "vite"
        },
        "backend": {
            "entrypoint": "backend",
            "routePrefix": "/_/backend"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://secure-college-hostel-management-system-2.onrender.com/api/:path*"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/"
        }
    ]
}